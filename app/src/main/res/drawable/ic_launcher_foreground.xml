<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow/Halo for Rocket -->
    <path
        android:pathData="M54,30 L64,55 L54,50 L44,55 Z"
        android:fillAlpha="0.3">
        <fillColor>
            <gradient
                android:startX="54"
                android:startY="30"
                android:endX="54"
                android:endY="55"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </fillColor>
    </path>

    <!-- Rocket Body -->
    <path
        android:pathData="M54,25C54,25 44,45 44,65C44,70 48,72 54,72C60,72 64,70 64,65C64,45 54,25 54,25Z"
        android:fillColor="#FFFFFF"/>

    <!-- Rocket Window -->
    <path
        android:pathData="M54,38A4,4 0,1 1,50 42A4,4 0,0 1,54 38"
        android:fillColor="#6366F1"/>

    <!-- Rocket Fins -->
    <path
        android:pathData="M44,60L38,72L44,72Z"
        android:fillColor="#E0E7FF"/>
    <path
        android:pathData="M64,60L70,72L64,72Z"
        android:fillColor="#E0E7FF"/>

    <!-- Checkmark Symbol on Rocket -->
    <path
        android:pathData="M50,58L53,61L58,55"
        android:strokeWidth="2"
        android:strokeColor="#6366F1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Bottom Exhaust/Flame -->
    <path
        android:pathData="M50,72L54,82L58,72Z"
        android:fillAlpha="0.8">
        <fillColor>
            <gradient
                android:startX="54"
                android:startY="72"
                android:endX="54"
                android:endY="82"
                android:type="linear">
                <item android:offset="0" android:color="#EC4899" />
                <item android:offset="1" android:color="#00EC4899" />
            </gradient>
        </fillColor>
    </path>

</vector>